    "entities": "^6.0.1",
    "happy-dom": "^21.0.4",
    "nostics": "^1.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
